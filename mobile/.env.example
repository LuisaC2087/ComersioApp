# Copia este archivo como ".env" para correr la app en tu PC con "npx expo start".
# En Render estas mismas variables se configuran en el servicio "tienda-web" > Environment.

# URLs de los microservicios (para usar los de tu PC, pon la IP de tu PC, ej. http://192.168.1.50:3001)
EXPO_PUBLIC_USUARIOS_URL=https://tienda-usuarios.onrender.com
EXPO_PUBLIC_PRODUCTOS_URL=https://tienda-productos-dxd5.onrender.com
EXPO_PUBLIC_PEDIDOS_URL=https://tienda-pedidos-brue.onrender.com

# Datos de la tienda (aparecen en la factura)
EXPO_PUBLIC_TIENDA_NOMBRE=Glass Store
EXPO_PUBLIC_TIENDA_NIT=1234567-8
EXPO_PUBLIC_TIENDA_DIRECCION=Ciudad de Guatemala
EXPO_PUBLIC_TIENDA_TELEFONO=+502 2222-3333

EXPO_PUBLIC_MONEDA=$
EXPO_PUBLIC_IVA=0.12
